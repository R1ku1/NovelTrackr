{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "noveltrackr",
  "version": "0.1.0",
  "identifier": "com.aweso.noveltrackr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
      "title": "noveltrackr",
    "width": 1200,
    "height": 800,
    "maximized": true,
    "backgroundColor": "#0f0f13"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
