{
  "name": "noveltrackr",
  "private": true,
  "version": "2.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "extension:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish.ps1 -PackageOnly",
    "extension:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish.ps1 -StatusOnly",
    "extension:upload": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish.ps1 -UploadOnly",
    "extension:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish.ps1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:app && npm run test:extension",
    "test:app": "node src/selfcheck.mjs",
    "test:extension": "node extension/selfcheck.mjs",
    "test:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-publish.ps1",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "npm test && npm run test:publish && npm run test:rust",
    "verify": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.0.4"
  }
}
